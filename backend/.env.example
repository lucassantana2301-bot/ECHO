# ECHO Backend Environment Configuration
# Copy this file to `backend/.env` to configure a live provider.

# Database
ECHO_DATABASE_URL=postgresql+psycopg://echo:echo@localhost:5432/echo
ECHO_JWT_SECRET=dev-only-insecure-secret-change-me

# --- PROVIDER OPTION 1: Google Gemini ---
# ECHO_PROVIDER_MODE=live
# ECHO_LLM_PROVIDER=gemini
# ECHO_LLM_API_KEY=sua_chave_gemini_aqui
# ECHO_LLM_MODEL=gemini-2.5-flash
# ECHO_EMBED_PROVIDER=gemini
# ECHO_EMBED_MODEL=text-embedding-004
# ECHO_EMBED_DIM=768

# --- PROVIDER OPTION 2: OpenAI ---
# ECHO_PROVIDER_MODE=live
# ECHO_LLM_PROVIDER=openai
# ECHO_LLM_API_KEY=sua_chave_openai_aqui
# ECHO_LLM_MODEL=gpt-4o-mini
# ECHO_EMBED_PROVIDER=openai
# ECHO_EMBED_MODEL=text-embedding-3-small
# ECHO_EMBED_DIM=1536

# --- PROVIDER OPTION 3: Anthropic Claude ---
